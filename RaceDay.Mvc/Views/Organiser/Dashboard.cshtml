@model List<RaceDay.Mvc.Models.EventViewModel>
@{ViewData["Title"]="Organiser dashboard";}<div class="d-flex flex-wrap justify-content-between align-items-end mb-4"><div><span class="eyebrow">Race operations</span><h1 class="h2 mb-0">Organiser dashboard</h1></div><a class="btn btn-lime" asp-action="CreateEvent">+ Create event</a></div><div class="row g-3 mb-4"><div class="col-sm-4"><div class="metric-card"><span>Your events</span><strong>@Model.Count</strong></div></div><div class="col-sm-4"><div class="metric-card"><span>Upcoming</span><strong>@Model.Count(e=>e.EventDate>=DateTime.Today)</strong></div></div><div class="col-sm-4"><div class="metric-card"><span>Enrolments</span><strong>@Model.Sum(e=>e.TotalEnrolments)</strong></div></div></div>@if(Model.Count==0){<div class="empty-state"><p>You have not created an event yet.</p><a class="btn btn-dark" asp-action="CreateEvent">Create your first event</a></div>}<div class="row g-3">@foreach(var e in Model){<div class="col-md-6 col-xl-4"><article class="event-card p-4"><span class="badge event-type">@e.EventType</span><h2 class="h5 mt-3">@e.EventName</h2><p class="text-muted">@e.Location · @e.EventDate.ToString("d MMM yyyy")</p><p><strong>@e.TotalEnrolments</strong> participant enrolments</p><a class="btn btn-dark w-100" asp-action="ManageEvent" asp-route-id="@e.EventId">Manage event →</a></article></div>}</div>
