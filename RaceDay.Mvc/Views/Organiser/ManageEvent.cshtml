@model RaceDay.Mvc.Models.EventViewModel
@{ViewData["Title"]="Manage event";var cats=ViewBag.Categories as List<RaceDay.Mvc.Models.CategoryViewModel>??new();var entries=ViewBag.Enrolments as List<RaceDay.Mvc.Models.EnrolmentViewModel>??new();var results=ViewBag.Results as List<RaceDay.Mvc.Models.ResultViewModel>??new();}
<a asp-action="Dashboard">← Dashboard</a><div class="d-flex flex-wrap justify-content-between mt-3 mb-4"><div><span class="eyebrow">Event management</span><h1 class="h2">@Model.EventName</h1><p class="text-muted">@Model.EventDate.ToString("f") · @Model.Location</p></div><div class="d-flex align-items-start gap-2"><a class="btn btn-outline-dark" asp-action="EditEvent" asp-route-id="@Model.EventId">Edit event</a><form asp-action="DeleteEvent" method="post" onsubmit="return confirm('Delete this event and its related data? This cannot be undone.');"><input type="hidden" name="id" value="@Model.EventId"/><button class="btn btn-outline-danger">Delete event</button></form>@if(!string.IsNullOrWhiteSpace(Model.BannerImageUrl)){<img class="manage-banner" src="@Model.BannerImageUrl" alt="Event banner"/>}</div></div>
<div class="row g-4"><section class="col-lg-5"><div class="event-card p-4 mb-4"><h2 class="h5">Event banner</h2><form asp-action="UploadBanner" method="post" enctype="multipart/form-data"><input type="hidden" name="id" value="@Model.EventId"/><input type="file" name="file" class="form-control mb-2" accept="image/png,image/jpeg,image/webp" required/><button class="btn btn-outline-dark">Upload banner</button></form></div><div class="event-card p-4"><h2 class="h5">Add category</h2><form asp-action="AddCategory" method="post"><input type="hidden" name="eventId" value="@Model.EventId"/><div class="mb-2"><label class="form-label">Category name</label><input name="CategoryName" class="form-control" required maxlength="100"/></div><div class="row"><div class="col-4"><label class="form-label">Distance km</label><input name="DistanceKm" type="number" min="0.01" step="0.01" class="form-control" required/></div><div class="col-4"><label class="form-label">Places</label><input name="MaxParticipants" type="number" min="1" class="form-control" value="100" required/></div><div class="col-4"><label class="form-label">Fee (R)</label><input name="EntryFee" type="number" min="0" step="0.01" class="form-control" value="0" required/></div></div><button class="btn btn-dark mt-3">Add category</button></form><hr/>@if(cats.Count==0){<p class="text-muted">No categories created yet.</p>}else{<ul class="list-group list-group-flush">@foreach(var c in cats){<li class="list-group-item px-0">@c.CategoryName <span class="text-muted">· @c.DistanceKm km · R @c.EntryFee</span></li>}</ul>}</div></section>
<section class="col-lg-7"><div class="event-card p-4 mb-4"><h2 class="h5">Participants enrolled (@entries.Count)</h2>@if(entries.Count==0){<p class="text-muted">No entries yet.</p>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Participant</th><th>Category</th><th>Status</th></tr></thead><tbody>@foreach(var x in entries){<tr><td>@x.Participant?.FirstName @x.Participant?.LastName</td><td>@x.CategoryName</td><td><span class="status-pill @(x.Status=="Confirmed"?"status-good":"status-wait")">@x.Status</span></td></tr>}</tbody></table></div>}</div><div class="event-card p-4 mb-4"><h2 class="h5">Record participant results</h2>@if(entries.Count==0){<p class="text-muted">Participant entries will appear here once they enrol.</p>}else{<form asp-action="RecordResult" method="post"><input type="hidden" name="eventId" value="@Model.EventId"/><div class="mb-2"><label class="form-label">Participant entry</label><select name="EnrolmentId" class="form-select" required><option value="">Choose enrolment</option>@foreach(var e in entries){<option value="@e.EnrolmentId">@e.Participant?.FirstName @e.Participant?.LastName · @e.CategoryName · @e.Status</option>}</select></div><div class="row"><div class="col-md-4 mb-2"><label class="form-label">Finish time</label><input name="FinishTime" class="form-control" placeholder="01:25:30" pattern="[0-9]{1,2}:[0-5][0-9]:[0-5][0-9]" required/></div><div class="col-md-4 mb-2"><label class="form-label">Position</label><input name="Position" type="number" min="1" class="form-control" required/></div><div class="col-md-4 mb-2"><label class="form-label">Status</label><select name="ResultStatus" class="form-select"><option>Official</option><option>Pending</option><option>Disqualified</option></select></div></div><button class="btn btn-dark mt-2">Save result</button></form>}</div><div class="event-card p-4"><h2 class="h5">Recorded results (@results.Count)</h2>@if(results.Count==0){<p class="text-muted">No results have been recorded yet.</p>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Enrolment</th><th>Time</th><th>Position</th><th>Status</th></tr></thead><tbody>@foreach(var r in results){<tr><td>@r.EnrolmentId</td><td>@(r.FinishTime?.ToString()??"—")</td><td>@(r.Position?.ToString()??"—")</td><td>@r.ResultStatus</td></tr>}</tbody></table></div>}</div></section></div>
