@model List<RaceDay.Mvc.Models.ResultViewModel>
@{ViewData["Title"]="My results";}<span class="eyebrow">Your personal race history</span><h1 class="h2 mb-4">My results</h1>@if(Model.Count==0){<div class="empty-state"><p>Your official results will appear here after an organiser records them.</p><a class="btn btn-outline-dark" asp-controller="Home" asp-action="Index">Browse events</a></div>}else{<div class="table-responsive event-card p-2"><table class="table align-middle mb-0"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th><th>Status</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.Category?.Event?.EventName</td><td>@r.Category?.Event?.EventDate.ToString("d MMM yyyy")</td><td>@r.Category?.CategoryName (@r.Category?.DistanceKm km)</td><td>@(r.FinishTime?.ToString()??"—")</td><td>@(r.Position?.ToString()??"—") of @r.TotalFinishers</td><td><span class="status-pill status-good">@r.ResultStatus</span></td></tr>}</tbody></table></div>}
