@model RaceDay.Mvc.Models.ProfileViewModel
@{ViewData["Title"]="My profile";}<span class="eyebrow">Account settings</span><h1 class="h2 mb-4">My profile</h1><div class="row g-4"><div class="col-lg-4"><div class="event-card p-4 text-center">@if(!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl)){<img class="profile-image mb-3" src="@Model.ProfilePictureUrl" alt="Profile picture"/>}else{<div class="profile-placeholder mb-3">@Model.FirstName.FirstOrDefault()</div>}<h2 class="h5">@Model.FirstName @Model.LastName</h2><span class="badge event-type">@Model.Role</span><hr/><form asp-action="UploadProfilePicture" method="post" enctype="multipart/form-data"><label class="form-label">Profile picture</label><input type="file" name="file" class="form-control mb-2" accept="image/png,image/jpeg,image/webp" required/><button class="btn btn-outline-dark w-100">Upload picture</button></form></div></div><div class="col-lg-8"><div class="event-card p-4"><form asp-action="Profile" method="post"><input type="hidden" asp-for="UserId"/><input type="hidden" asp-for="Role"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control"/><span asp-validation-for="FirstName" class="text-danger"></span></div><div class="mb-3"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control"/><span asp-validation-for="LastName" class="text-danger"></span></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/><span asp-validation-for="Email" class="text-danger"></span></div><button class="btn btn-dark">Save changes</button></form></div></div></div>
