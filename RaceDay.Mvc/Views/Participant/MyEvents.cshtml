@model List<RaceDay.Mvc.Models.EnrolmentViewModel>
@{ViewData["Title"]="My events";}<span class="eyebrow">Your race calendar</span><h1 class="h2 mb-4">My events</h1>@if(Model.Count==0){<div class="empty-state"><p>You haven’t entered an event yet.</p><a class="btn btn-dark" asp-controller="Home" asp-action="Index">Explore events</a></div>}<div class="row g-3">@foreach(var e in Model){<div class="col-md-6"><div class="event-card p-4"><div class="d-flex justify-content-between"><h2 class="h5">@e.Category?.Event?.EventName</h2><span class="status-pill @(e.Status=="Confirmed"?"status-good":"status-wait")">@e.Status</span></div><p class="mb-1">@e.Category?.CategoryName · @e.Category?.DistanceKm km</p><p class="text-muted mb-0">@e.Category?.Event?.EventDate.ToString("ddd, d MMM yyyy")</p></div></div>}</div>
