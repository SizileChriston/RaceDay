@model RaceDay.Mvc.Models.EventViewModel
@{ViewData["Title"]=Model.EventName;var cats=ViewBag.Categories as List<RaceDay.Mvc.Models.CategoryViewModel>??new();}
<a class="text-decoration-none" asp-controller="Home" asp-action="Index">← All events</a><section class="detail-hero mt-3">@if(!string.IsNullOrWhiteSpace(Model.BannerImageUrl)){<img src="@Model.BannerImageUrl" alt="Banner for @Model.EventName"/>}<div><span class="badge event-type">@Model.EventType</span><h1 class="display-6 fw-bold mt-2">@Model.EventName</h1><p class="lead">@Model.Description</p><p><strong>@Model.EventDate.ToString("dddd, d MMMM yyyy · HH:mm")</strong><br/>@Model.Location</p></div></section><h2 class="h3 mt-4">Choose your category</h2><div class="row g-3">@foreach(var c in cats){<div class="col-md-6 col-lg-4"><div class="event-card p-4"><h3 class="h5">@c.CategoryName</h3><p>@c.DistanceKm km · Entry R @c.EntryFee.ToString("0.00")</p>@if(User.IsInRole("Participant")){<form asp-action="Enter" method="post"><input type="hidden" name="categoryId" value="@c.CategoryId"/><button class="btn btn-lime w-100">Enter this event</button></form>}else if(!User.Identity!.IsAuthenticated){<a class="btn btn-dark w-100" asp-controller="Account" asp-action="Login">Sign in to enter</a>}</div></div>}</div>
