<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>@ViewData["Title"] - RaceDay</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/raceday.css" asp-append-version="true"/></head>
<body><header><nav class="navbar navbar-expand-lg navbar-dark raced-nav"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index"><span class="brand-mark">R</span> RaceDay</a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="mainNav"><ul class="navbar-nav me-auto"><li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Events</a></li>@if(User.IsInRole("Participant")){<li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My events</a></li><li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My results</a></li><li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a></li>}@if(User.IsInRole("Organiser")){<li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Organiser dashboard</a></li>}</ul><div class="d-flex align-items-center gap-2">@if(User.Identity?.IsAuthenticated==true){<span class="small text-white-50">Hi, @User.Identity.Name</span><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Sign out</button></form>}else{<a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Sign in</a><a class="btn btn-lime btn-sm" asp-controller="Account" asp-action="Register">Join RaceDay</a>}</div></div></div></nav></header>
<main class="container py-4">@if(TempData["Message"] is string message){<div class="alert alert-success alert-dismissible fade show">@message<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}@if(TempData["Error"] is string error){<div class="alert alert-danger alert-dismissible fade show">@error<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>}@RenderBody()</main><footer class="container py-4 text-center text-muted small">RaceDay · Find your next finish line.</footer><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
