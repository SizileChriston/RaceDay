@model List<RaceDay.Mvc.Models.EventViewModel>
@{ViewData["Title"]="Upcoming events";}
<section class="hero p-4 p-lg-5 mb-4"><div class="row align-items-center"><div class="col-lg-8"><span class="eyebrow">South Africa moves together</span><h1 class="display-5 fw-bold mt-2">Your next finish line<br/><span>starts here.</span></h1><p class="lead">Discover community runs, walks and rides. Choose your event and make race day yours.</p><a class="btn btn-lime btn-lg" href="#events">Explore events</a></div><div class="col-lg-4 d-none d-lg-block"><div class="hero-stats"><strong>@Model.Count</strong><span>events to explore</span><div class="route-line"></div><small>Every pace. Every finish.</small></div></div></div></section>
<section id="events"><div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3"><div><span class="eyebrow">On the calendar</span><h2 class="h3 mb-0">Upcoming events</h2></div><form method="get" class="d-flex flex-wrap gap-2"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search name or location" aria-label="Search events"/><select class="form-select" name="eventType"><option value="">All event types</option><option value="Running">Running</option><option value="Walking">Walking</option><option value="Cycling">Cycling</option></select><button class="btn btn-dark">Filter</button></form></div>
@if(Model.Count==0){<div class="empty-state"><h3>No events found</h3><p>Try another search, or check back soon for more RaceDay events.</p></div>}<div class="row g-3">@foreach(var item in Model){<div class="col-md-6 col-xl-4"><article class="event-card h-100">@if(!string.IsNullOrWhiteSpace(item.BannerImageUrl)){<img class="event-banner" src="@item.BannerImageUrl" alt="Banner for @item.EventName"/>}else{<div class="event-banner placeholder-banner"><span>@item.EventType</span><b>RACE<br/>DAY</b></div>}<div class="p-4"><span class="badge event-type">@item.EventType</span><h3 class="h5 mt-3">@item.EventName</h3><p class="text-muted mb-2">@item.Location</p><p class="mb-3"><strong>@item.EventDate.ToString("ddd, d MMM yyyy · HH:mm")</strong></p><a class="btn btn-dark w-100" asp-controller="Participant" asp-action="Details" asp-route-id="@item.EventId">Event details →</a></div></article></div>}</div></section>
